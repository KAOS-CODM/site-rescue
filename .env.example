# OpenRouter — get a key at https://openrouter.ai/keys
# The default model, inclusionai/ling-3.0-flash, may require OpenRouter credits.
# Copy this file to .env and fill in your key.
# Never commit .env or paste your API key into chat.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=inclusionai/ling-3.0-flash